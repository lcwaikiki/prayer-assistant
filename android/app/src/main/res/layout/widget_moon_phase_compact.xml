<?xml version="1.0" encoding="utf-8"?>
<!-- Narrow (about 2 cells wide) variant of widget_moon_phase: stacked vertically. Same view ids. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetMoonRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/widgetMoonDateHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:text="14 Safar 1448"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetMoonWhiteDaysBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/fasting_pill_badge"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="White Days"
        android:textColor="#FFFFD700"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widgetMoonGraphic"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="6dp"
        android:layout_weight="1"
        android:contentDescription="Moon Phase"
        android:maxHeight="72dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/widgetMoonPhaseName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:text="Waxing Gibbous"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetMoonIllumination"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="82% Illuminated"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widgetMoonSubHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="September 5, 2026"
        android:textColor="#80FFFFFF"
        android:textSize="10sp" />
</LinearLayout>
